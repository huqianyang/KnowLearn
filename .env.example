# KnowLearn 配置模板：复制为 .env 后填写。.env 不提交到 git。

# ===== 硅基流动（LLM / 视觉模型） =====
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# ===== 本机模型 =====
EMBEDDING_MODEL_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
RERANK_MODEL_PATH=D:\ai_models\rerank\rerank\BAAI\bge-reranker-large

# ===== 阿里云百炼 WebSearch MCP =====
DASHSCOPE_API_KEY=
WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===== MinerU 云端解析 API =====
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4

# ===== Milvus =====
MILVUS_URI=http://192.168.10.100:19530
MILVUS_COLLECTION=knowlearn_chunks

# ===== MongoDB =====
MONGO_URL=mongodb://<user>:<password>@192.168.10.100:27017/?authSource=admin
MONGO_DB_NAME=knowlearn

# ===== MinIO =====
MINIO_ENDPOINT=192.168.10.100:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=knowlearn
MINIO_SECURE=false
MINIO_PUBLIC_BASE=http://192.168.10.100:9000
